# Copy this to .env and uncomment + fill in whatever you actually want to
# override. .env itself is gitignored -- never commit it with real
# credentials in it.
#
# IMPORTANT: every line below is commented out on purpose. Uncommenting a
# line with nothing after the "=" (e.g. LIBRARY_DIR=) is NOT the same as
# leaving it commented out -- python-dotenv sets it to an actual empty
# string, and the app's os.environ.get('LIBRARY_DIR', <default>) only
# falls back to <default> when the key is entirely ABSENT, not when it's
# present-but-empty. An uncommented blank line crashes the app on boot
# (this bit us while building this file -- LIBRARY_DIR='' made
# os.makedirs('') fail immediately). So: to use the built-in default,
# leave the line commented. To override it, uncomment AND fill in a value.

# ---- Storage paths ----
# LIBRARY_DIR=/path/to/trailer_library
# TEMPLATES_DIR=/path/to/show_templates
# SECRET_KEY_FILE=/path/to/.secret_key

# ---- Admin bootstrap / recovery (see README.md) ----
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-real-password
# Set to 1 to force-reset the admin account on next boot, then comment this
# back out (or delete it) once you've signed in with the new password.
# RESET_ADMIN=1

# ---- Production server (waitress, on by default -- see README) ----
# WAITRESS_THREADS=8
# Set to 1 to use Flask's dev server instead, for local troubleshooting only.
# DEV_SERVER=1

# ---- Session / cookies ----
# SESSION_LIFETIME_DAYS=30
# Set to 1 only once the app is actually served over HTTPS -- a Secure
# cookie is silently never sent over plain HTTP, which looks like the
# login gate not working.
# FORCE_HTTPS=1

# ---- Rate limiting ----
# LOGIN_RATE_LIMIT=8
# FILE_ROUTE_RATE_LIMIT=40

# ---- AI services (all optional -- the app degrades gracefully if any of
# these are unreachable) ----
# OLLAMA_URL=http://localhost:11434
# FISH_AUDIO_URL=http://localhost:8080/v1/tts
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_MODEL=s2.1-pro-free
# WHISPER_URL=http://localhost:8000
# WHISPER_MODEL=large-v2
# ACE_STEP_URL=http://localhost:8001
# ACE_STEP_API_KEY=
# ACE_STEP_STEPS=27
# ACE_STEP_MAX_SAMPLES=4
# ACE_STEP_REF_DIR=
# WOOSH_URL=http://localhost:8030
# WOOSH_MAX_SAMPLES=4
# AI_NUM_PREDICT=400
# AI_SCORE_LIMIT=60
# AI_SCORE_WORKERS=4

# ---- Network (SMB) share browsing ----
# No env vars for this -- each of the six browsable categories (HIRES,
# title/end cards, music, VO, SFX) is configured independently from
# Config > Network in the app itself (admin-only): a full network path,
# username, and password per category, with no shared default between
# them. Takes effect immediately, no restart needed.

# ---- Timeouts (seconds) ----
# FFMPEG_TIMEOUT=300
# FFMPEG_LONG_TIMEOUT=1800
# FFPROBE_TIMEOUT=30
# TTS_TIMEOUT=120
# CHAT_TIMEOUT=60

# ---- AI Chat tab ----
# CHAT_MAX_HISTORY=40
# CHAT_MAX_IMAGES_PER_MESSAGE=4
# CHAT_MAX_IMAGE_BYTES=10485760
# CHAT_ATTACH_MAX_BYTES=10485760
# CHAT_ATTACH_MAX_CHARS=20000

# ---- Audio ducking ----
# DUCK_ATTACK=0.3
# DUCK_RELEASE=1.0

# ---- Jobs / previews / uploads housekeeping ----
# MAX_CONCURRENT_JOBS=2
# PREVIEW_ALTERNATES=6
# PREVIEW_TTL=7200
# UPLOAD_TTL=21600
# UPLOAD_SWEEP_INTERVAL=1800
# VOICES_CACHE_TTL=300
# EXTRACT_WORKERS=4

# ---- Standard OS temp dir overrides (optional) ----
# TEMP=/path/to/temp
# TMP=/path/to/temp
