# Copy this to .env and uncomment + fill in whatever you actually want to
# override. .env itself is gitignored -- never commit it with real
# credentials in it.
#
# IMPORTANT: every line below is commented out on purpose. Uncommenting a
# line with nothing after the "=" (e.g. LIBRARY_DIR=) is NOT the same as
# leaving it commented out -- python-dotenv sets it to an actual empty
# string, and the app's os.environ.get('LIBRARY_DIR', <default>) only
# falls back to <default> when the key is entirely ABSENT, not when it's
# present-but-empty. An uncommented blank line crashes the app on boot
# (this bit us while building this file -- LIBRARY_DIR='' made
# os.makedirs('') fail immediately). So: to use the built-in default,
# leave the line commented. To override it, uncomment AND fill in a value.

# ---- Storage paths ----
# LIBRARY_DIR=/path/to/trailer_library
# TEMPLATES_DIR=/path/to/show_templates
# SECRET_KEY_FILE=/path/to/.secret_key

# ---- Admin bootstrap / recovery (see README.md) ----
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-real-password
# Set to 1 to force-reset the admin account on next boot, then comment this
# back out (or delete it) once you've signed in with the new password.
# RESET_ADMIN=1

# ---- Production server (waitress, on by default -- see README) ----
# WAITRESS_THREADS=8
# Set to 1 to use Flask's dev server instead, for local troubleshooting only.
# DEV_SERVER=1

# ---- Session / cookies ----
# Default is now 1 day (was 30). A month-long session is a month-long
# window for a stolen cookie or an unattended browser to stay valid.
# SESSION_LIFETIME_DAYS=1
# Set to 1 only once the app is actually served over HTTPS -- a Secure
# cookie is silently never sent over plain HTTP, which looks like the
# login gate not working. Safe (and expected) when TLS is terminated at a
# reverse proxy, provided TRUST_PROXY_HEADERS below is also set.
# FORCE_HTTPS=1

# ---- Reverse proxy ----
# REQUIRED when running behind nginx/cloudflared/any proxy. Without it,
# Flask sees the PROXY's address as the client IP for every request, which
# collapses every per-IP rate limit below into a single shared bucket for
# the whole internet, and leaves request.is_secure always False so HSTS is
# never sent.
#
# Opt-in rather than automatic on purpose: X-Forwarded-* headers are
# trivially forged by anyone who can reach the app DIRECTLY, so only enable
# this once the app is genuinely reachable solely through the proxy.
# TRUST_PROXY_HEADERS=1
# Number of proxies in front of the app -- 1 for nginx alone, 2 for a chain
# like cloudflared -> nginx -> app.
# TRUST_PROXY_HOPS=1

# ---- Authentication ----
# Minimum password length for new/changed passwords. Length is the only
# hard rule on purpose -- forced character-class requirements reliably
# produce "Password1!" rather than stronger secrets.
# MIN_PASSWORD_LENGTH=12
# Per-ACCOUNT lockout, complementing the per-IP LOGIN_RATE_LIMIT below.
# The IP limiter alone is bypassed by a distributed attempt (many source
# IPs against one target account).
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCKOUT_MINUTES=15
# Set to 0/false to skip transcription when placing cut points. On by
# default -- it's what keeps cuts off the middle of a spoken line.
# SPEECH_SAFE_CUTS=1

# ---- Media upload policy ----
# OFF by default: media can only come from the configured network shares
# (Browse Library) or AI generation, and direct browser uploads of
# video/audio are rejected server-side.
#
# The reason is ffmpeg specifically -- every media file supplied to this app
# eventually reaches it, and it's a large C codebase with a long history of
# parser CVEs. Not accepting arbitrary media at all is a much stronger
# control than validating it more carefully.
#
# Set to 1 to allow direct uploads again (reasonable on an isolated LAN
# where convenience matters more). Script/rundown uploads and AI Assistant
# document attachments are unaffected either way -- those are parsed by
# pypdf/tesseract, never by ffmpeg.
# ALLOW_LOCAL_MEDIA_UPLOAD=1

# ---- Rate limiting ----
# LOGIN_RATE_LIMIT=8
# FILE_ROUTE_RATE_LIMIT=40
# Render submissions per client per 5 minutes. Separate from
# MAX_CONCURRENT_JOBS, which caps how many run AT ONCE but happily accepts
# an unbounded queue behind it.
# JOB_SUBMIT_RATE_LIMIT=12

# ---- AI services (all optional -- the app degrades gracefully if any of
# these are unreachable) ----
# OLLAMA_URL=http://localhost:11434
# FISH_AUDIO_URL=http://localhost:8080/v1/tts
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_MODEL=s2.1-pro-free
# WHISPER_URL=http://localhost:8000
# WHISPER_MODEL=large-v2
# ACE_STEP_URL=http://localhost:8001
# ACE_STEP_API_KEY=
# ACE_STEP_STEPS=27
# ACE_STEP_MAX_SAMPLES=4
# ACE_STEP_REF_DIR=
# WOOSH_URL=http://localhost:8030
# WOOSH_MAX_SAMPLES=4
# AI_NUM_PREDICT=400
# AI_SCORE_LIMIT=60
# AI_SCORE_WORKERS=4

# ---- Network (SMB) share browsing ----
# No env vars for this -- each of the six browsable categories (HIRES,
# title/end cards, music, VO, SFX) is configured independently from
# Config > Network in the app itself (admin-only): a full network path,
# username, and password per category, with no shared default between
# them. Takes effect immediately, no restart needed.

# ---- Timeouts (seconds) ----
# FFMPEG_TIMEOUT=300
# FFMPEG_LONG_TIMEOUT=1800
# FFPROBE_TIMEOUT=30
# TTS_TIMEOUT=120
# CHAT_TIMEOUT=60

# ---- AI Chat tab ----
# CHAT_MAX_HISTORY=40
# CHAT_MAX_IMAGES_PER_MESSAGE=4
# CHAT_MAX_IMAGE_BYTES=10485760
# CHAT_ATTACH_MAX_BYTES=10485760
# CHAT_ATTACH_MAX_CHARS=20000

# ---- Audio ducking ----
# DUCK_ATTACK=0.3
# DUCK_RELEASE=1.0

# ---- Jobs / previews / uploads housekeeping ----
# MAX_CONCURRENT_JOBS=2
# PREVIEW_ALTERNATES=6
# PREVIEW_TTL=7200
# UPLOAD_TTL=21600
# UPLOAD_SWEEP_INTERVAL=1800
# VOICES_CACHE_TTL=300
# EXTRACT_WORKERS=4

# ---- Standard OS temp dir overrides (optional) ----
# TEMP=/path/to/temp
# TMP=/path/to/temp
