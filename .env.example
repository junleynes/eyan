# Copy this to .env (or set these in your process manager / pm2 ecosystem
# file) and fill in real values. .env itself is gitignored -- never commit
# it with real credentials in it.

# ---- Storage paths ----
LIBRARY_DIR=
TEMPLATES_DIR=
SECRET_KEY_FILE=

# ---- Admin bootstrap / recovery (see README.md) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to 1 to force-reset the admin account on next boot, then unset it again.
RESET_ADMIN=

# ---- Session / cookies ----
SESSION_LIFETIME_DAYS=30
# Set to 1 only once the app is actually served over HTTPS -- a Secure
# cookie is silently never sent over plain HTTP, which looks like the
# login gate not working.
FORCE_HTTPS=

# ---- Rate limiting ----
LOGIN_RATE_LIMIT=8
FILE_ROUTE_RATE_LIMIT=40

# ---- AI services (all optional -- the app degrades gracefully if any of
# these are unreachable) ----
OLLAMA_URL=http://localhost:11434
FISH_AUDIO_URL=
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
WHISPER_URL=http://localhost:8000
WHISPER_MODEL=large-v2
ACE_STEP_URL=http://localhost:8001
ACE_STEP_STEPS=
ACE_STEP_MAX_SAMPLES=
ACE_STEP_REF_DIR=
WOOSH_URL=http://localhost:8030
WOOSH_MAX_SAMPLES=
AI_NUM_PREDICT=400
AI_SCORE_LIMIT=60
AI_SCORE_WORKERS=

# ---- Network (SMB) share browsing ----
# No defaults for any of these on purpose -- a hardcoded fallback
# credential here is exactly the kind of thing that leaks into git history.
# Set all four (or none, if you don't use network-share browsing).
NETWORK_SHARE_HOST=
NETWORK_SHARE_NAME=
NETWORK_SHARE_SUBDIR=
NETWORK_SHARE_USERNAME=
NETWORK_SHARE_PASSWORD=

# ---- Timeouts (seconds) ----
FFMPEG_TIMEOUT=
FFMPEG_LONG_TIMEOUT=
FFPROBE_TIMEOUT=
TTS_TIMEOUT=
CHAT_TIMEOUT=

# ---- AI Chat tab ----
CHAT_MAX_HISTORY=
CHAT_MAX_IMAGES_PER_MESSAGE=
CHAT_MAX_IMAGE_BYTES=
CHAT_ATTACH_MAX_BYTES=
CHAT_ATTACH_MAX_CHARS=

# ---- Audio ducking ----
DUCK_ATTACK=
DUCK_RELEASE=

# ---- Jobs / previews / uploads housekeeping ----
MAX_CONCURRENT_JOBS=2
PREVIEW_ALTERNATES=
PREVIEW_TTL=7200
UPLOAD_TTL=21600
UPLOAD_SWEEP_INTERVAL=
VOICES_CACHE_TTL=
EXTRACT_WORKERS=

# ---- Standard OS temp dir overrides (optional) ----
TEMP=
TMP=
